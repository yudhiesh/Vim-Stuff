{
  "lastChangelogVersion": "1.3.0",
  "theme": "catppuccin-mocha",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "defaultTools": [
    "+codemode"
  ],
  "packages": [
    {
      "source": "npm:pi-web-access",
      "skills": []
    },
    {
      "source": "npm:@dietrichgebert/ponytail",
      "skills": []
    },
    "npm:pi-vim",
    {
      "source": "npm:context-mode",
      "skills": []
    },
    "npm:@narumitw/pi-usage",
    "npm:@alasano/pi-linear",
    "npm:@diegopetrucci/pi-notify",
    "npm:@narumitw/pi-plan-mode",
    "npm:pi-agentsmd",
    "npm:pi-subagents",
    "npm:@sherif-fanous/pi-catppuccin",
    "npm:@mazli/pi-worktree",
    "npm:pi-intercom",
    "npm:pi-mcp-adapter",
    "git:github.com/algal/pi-openai-server-compaction",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:@andrewjacop/pi-herdr"
  ],
  "hideThinkingBlock": true,
  "defaultThinkingLevel": "max",
  "subagents": {
    "defaultModel": "openai-codex/gpt-6-luna",
    "modelScope": {
      "enforce": true,
      "allow": [
        "openrouter/deepseek/deepseek-v4.1-flash:nitro",
        "openai-codex/gpt-6-luna",
        "anthropic/claude-sonnet-5-5",
        "anthropic/claude-opus-5-5",
        "claude-opus-5.5"
      ]
    },
    "agentOverrides": {
      "scout": {
        "model": "openrouter/deepseek/deepseek-v4.1-flash:nitro",
        "thinking": "medium"
      },
      "delegate": {
        "model": "openrouter/deepseek/deepseek-v4.1-flash:nitro",
        "thinking": "low"
      },
      "worker": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "high"
      },
      "context-builder": {
        "model": "anthropic/claude-sonnet-5-5",
        "thinking": "medium"
      },
      "researcher": {
        "model": "anthropic/claude-sonnet-5-5",
        "thinking": "medium"
      },
      "evidence-auditor": {
        "model": "anthropic/claude-sonnet-5-5",
        "thinking": "high"
      },
      "planner": {
        "model": "anthropic/claude-opus-5-5",
        "thinking": "xhigh"
      },
      "reviewer": {
        "model": "anthropic/claude-sonnet-5-5",
        "thinking": "high"
      },
      "oracle": {
        "model": "anthropic/claude-opus-5-5",
        "thinking": "xhigh"
      },
      "claude-code": {
        "model": "claude-opus-5.5",
        "thinking": "xhigh"
      },
      "claude-code-writer": {
        "model": "claude-opus-5.5",
        "thinking": "xhigh"
      }
    }
  },
  "skills": [
    "-skills/writing-shape/SKILL.md",
    "+skills/ask-matt/SKILL.md",
    "+skills/aws-cost-tag-audit/SKILL.md",
    "+skills/aws-vault/SKILL.md",
    "+skills/aws-vault-access/SKILL.md",
    "+skills/batch-grill-me/SKILL.md",
    "+skills/caveman/SKILL.md",
    "+skills/claude-handoff/SKILL.md"
  ],
  "extensions": [
    "-builtin:mcp"
  ],
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "transcript",
  "fullscreenScrollbar": "always"
}
